{
  "name": "Superstore Midnight Teal",
  "dataColors": ["#2DD4BF", "#38BDF8", "#818CF8", "#F59E0B", "#F43F5E", "#A3E635", "#F472B6", "#94A3B8"],
  "background": "#0F172A",
  "foreground": "#E2E8F0",
  "tableAccent": "#2DD4BF",
  "good": "#2DD4BF",
  "neutral": "#F59E0B",
  "bad": "#F43F5E",
  "maximum": "#2DD4BF",
  "center": "#38BDF8",
  "minimum": "#1E293B",
  "null": "#64748B",
  "firstLevelElements": "#E2E8F0",
  "secondLevelElements": "#94A3B8",
  "thirdLevelElements": "#334155",
  "fourthLevelElements": "#1E293B",
  "secondaryBackground": "#1E293B",
  "textClasses": {
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#94A3B8" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#FFFFFF" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#E2E8F0" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#E2E8F0" },
    "largeTitle": { "fontFace": "Segoe UI Semibold", "fontSize": 20, "color": "#FFFFFF" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1E293B" } }, "transparency": 0, "show": true }],
        "border": [{ "color": { "solid": { "color": "#334155" } }, "radius": 12, "show": true }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E2E8F0" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold", "alignment": "left" }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": false }],
        "padding": [{ "top": 8, "bottom": 8, "left": 10, "right": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#0F172A" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#0F172A" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 26, "fontFamily": "Segoe UI Semibold" }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#94A3B8" } }, "fontSize": 10 }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#94A3B8" } }, "fontSize": 10 }],
        "items": [{ "fontColor": { "solid": { "color": "#E2E8F0" } }, "background": { "solid": { "color": "#0F172A" } }, "fontSize": 10 }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 3, "showMarker": false }],
        "categoryAxis": [{ "gridlineShow": false, "labelColor": { "solid": { "color": "#94A3B8" } } }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#334155" } }, "gridlineStyle": "dashed", "labelColor": { "solid": { "color": "#94A3B8" } } }]
      }
    },
    "areaChart": {
      "*": {
        "categoryAxis": [{ "gridlineShow": false }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#334155" } }, "gridlineStyle": "dashed" }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "categoryAxis": [{ "gridlineShow": false, "labelColor": { "solid": { "color": "#E2E8F0" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "fontSize": 9 }]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "categoryAxis": [{ "gridlineShow": false, "labelColor": { "solid": { "color": "#94A3B8" } } }],
        "valueAxis": [{ "show": false, "gridlineShow": false }],
        "labels": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "fontSize": 9 }]
      }
    },
    "donutChart": {
      "*": {
        "legend": [{ "show": true, "position": "Bottom", "labelColor": { "solid": { "color": "#94A3B8" } } }],
        "labels": [{ "color": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#2DD4BF" } }, "backColor": { "solid": { "color": "#0F172A" } }, "fontSize": 10 }],
        "values": [{ "fontColor": { "solid": { "color": "#E2E8F0" } }, "backColor": { "solid": { "color": "#1E293B" } }, "backColorPrimary": { "solid": { "color": "#1E293B" } }, "backColorSecondary": { "solid": { "color": "#243349" } }, "fontSize": 9 }],
        "grid": [{ "gridVertical": false, "gridHorizontalColor": { "solid": { "color": "#334155" } } }]
      }
    }
  }
}
